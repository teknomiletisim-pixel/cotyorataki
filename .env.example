# Bu dosyayı .env.local olarak kopyalayıp kendi değerlerinizi girin.

# PostgreSQL bağlantı adresi
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/cotyora

# Auth.js için rastgele, uzun bir gizli anahtar (üretim ortamında mutlaka değiştirin)
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=buraya_uzun_rastgele_bir_deger_girin
AUTH_TRUST_HOST=true

# Bu bilgilerle yönetici hesabı seed script'i tarafından oluşturulur (npm run db:seed)
ADMIN_EMAIL=sizin-mailiniz@ornek.com
ADMIN_PASSWORD=guclu_bir_sifre_belirleyin
ADMIN_FIRST_NAME=Emrah
ADMIN_LAST_NAME=Yönetici

# Lemonsqueezy: hesabınızdan alacağınız bilgiler
# https://app.lemonsqueezy.com/settings/api adresinden API anahtarı oluşturun
LEMONSQUEEZY_API_KEY=
# Mağaza ayarlarınızdan Store ID
LEMONSQUEEZY_STORE_ID=
# Mağazanızda "Sipariş Ödemesi" adında, fiyatı checkout anında özelleştirilebilen
# (custom price) bir ürün/variant oluşturup buraya ID'sini girin
LEMONSQUEEZY_VARIANT_ID=
# Lemonsqueezy > Settings > Webhooks içinde oluşturacağınız webhook'un gizli anahtarı
LEMONSQUEEZY_WEBHOOK_SECRET=

# Sitenizin canlı adresi (üretimde https://sizinsiteniz.com gibi olmalı)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-posta bildirimleri (sipariş durumu ve talep güncellemeleri için) — Gmail ile gönderilir
# EMAIL_USER: bildirimleri göndermek için kullanacağınız Gmail adresi
EMAIL_USER=
# EMAIL_PASSWORD: Gmail normal şifreniz DEĞİL, "Uygulama Şifresi" (App Password).
# Nasıl oluşturulacağı README.md içinde adım adım anlatılmıştır.
EMAIL_PASSWORD=
# EMAIL_FROM: e-postalarda gönderen olarak görünecek isim (adres değil)
EMAIL_FROM=COTYORA TAKI

# Google ile giriş (opsiyonel). Boş bırakılırsa "Google ile Devam Et"
# butonu sitede hiç görünmez, sadece e-posta/şifre girişi çalışır.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yönetici bildirimlerinin (yeni sipariş, yeni talep vb.) gideceği adres.
# Boş bırakılırsa EMAIL_USER kullanılır. ADMIN_EMAIL zaten yukarıda tanımlı.
